// Cloudflare : un seul Worker sert les trois adresses, à partir du dossier web/.
//   app.lecommis.ai       → l'app (web/)
//   lecommis.ai           → le site de vente (web/site/) ; www.lecommis.ai y renvoie
//   console.letabli.ai    → la console (web/console/); console.holdingai.app, l'ancienne adresse, y mène aussi
// La répartition se fait dans worker/index.js. Mise en ligne : Cloudflare Workers Builds, à chaque modification de main.
{
  "name": "lecommis",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "app.lecommis.ai", "custom_domain": true },
    { "pattern": "lecommis.ai", "custom_domain": true },
    { "pattern": "www.lecommis.ai", "custom_domain": true },
    { "pattern": "console.holdingai.app", "custom_domain": true },
    { "pattern": "console.letabli.ai", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
