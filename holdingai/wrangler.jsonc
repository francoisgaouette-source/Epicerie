// Site de L'Établi (letabli.ai), publié par Cloudflare Workers Builds à chaque modification de main.
// Dans Cloudflare, le Worker « holdingai » est relié à ce dépôt avec le dossier racine « holdingai ».
// Les fichiers du site sont dans holdingai/site/ : il n'y a aucune étape de compilation.
// holdingai.app et www.* redirigent (301) vers https://letabli.ai, en gardant le chemin (worker.js).
// Les sous-domaines de holdingai.app (compte, console, lavoute) et le courriel ne sont pas touchés.
{
  "name": "holdingai",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "main": "worker.js",
  "routes": [
    { "pattern": "letabli.ai", "custom_domain": true },
    { "pattern": "www.letabli.ai", "custom_domain": true },
    { "pattern": "holdingai.app", "custom_domain": true },
    { "pattern": "www.holdingai.app/*", "zone_name": "holdingai.app" }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
